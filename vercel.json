{
  "functions": {
    "api/payfast/notify.ts": {
      "includeFiles": "private/materials/**"
    },
    "api/admin/documents.ts": {
      "includeFiles": "{public/viva-tutorials-logo.png,private/fonts/PlusJakartaSans-Regular.ttf,private/fonts/PlusJakartaSans-Bold.ttf}",
      "maxDuration": 60
    },
    "api/admin/messages.ts": {
      "includeFiles": "{public/viva-tutorials-logo.png,private/fonts/PlusJakartaSans-Regular.ttf,private/fonts/PlusJakartaSans-Bold.ttf}",
      "maxDuration": 60
    },
    "api/admin/accounting.ts": {
      "includeFiles": "{public/viva-tutorials-logo.png,private/fonts/PlusJakartaSans-Regular.ttf,private/fonts/PlusJakartaSans-Bold.ttf}",
      "maxDuration": 60
    },
    "api/admin/session.ts": {
      "includeFiles": "{public/viva-tutorials-logo.png,private/fonts/PlusJakartaSans-Regular.ttf,private/fonts/PlusJakartaSans-Bold.ttf}",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/download/:path*",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/parent",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/tutor",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/tutor",
      "destination": "/api/admin/session?portal=tutor"
    },
    {
      "source": "/api/parent",
      "destination": "/api/admin/session?portal=parent"
    },
    {
      "source": "/download/:path*",
      "destination": "/materials/:path*"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/enroll",
      "destination": "/enroll/index.html"
    },
    {
      "source": "/tutors",
      "destination": "/tutors/index.html"
    },
    {
      "source": "/success-stories",
      "destination": "/success-stories/index.html"
    },
    {
      "source": "/mathematics",
      "destination": "/mathematics/index.html"
    },
    {
      "source": "/physical-science",
      "destination": "/physical-science/index.html"
    },
    {
      "source": "/life-sciences",
      "destination": "/life-sciences/index.html"
    },
    {
      "source": "/accounting",
      "destination": "/accounting/index.html"
    },
    {
      "source": "/geography",
      "destination": "/geography/index.html"
    },
    {
      "source": "/information-technology",
      "destination": "/information-technology/index.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service/index.html"
    },
    {
      "source": "/study-materials",
      "destination": "/study-materials/index.html"
    },
    {
      "source": "/payment-success",
      "destination": "/payment-success/index.html"
    },
    {
      "source": "/payment-cancelled",
      "destination": "/payment-cancelled/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/parent",
      "destination": "/index.html"
    },
    {
      "source": "/tutor",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/admin/accounting?task=scheduled",
      "schedule": "5 6 * * *"
    }
  ]
}
