# Frontend analytics (optional, only needed when Google Analytics is enabled)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase server configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Server-only PayFast Live configuration. Never prefix these with VITE_.
PAYFAST_MERCHANT_ID=your-live-merchant-id
PAYFAST_MERCHANT_KEY=your-live-merchant-key
PAYFAST_PASSPHRASE=
PAYFAST_NOTIFY_URL=https://www.vivatutorials.co.za/api/payfast/notify

# Email delivery via Resend
RESEND_API_KEY=re_replace-with-your-resend-key
EMAIL_FROM=Viva Tutorials <downloads@your-verified-domain.example>
ADMIN_EMAIL=vivatutorialservices@gmail.com

# Used to build PayFast return URLs in server responses.
PUBLIC_SITE_URL=https://www.vivatutorials.co.za

# Server-only bearer secret for accounting scheduled work. Use a long random value.
# Match this with the Viva cron secret stored in Supabase Vault if using its scheduler.
CRON_SECRET=

# Optional parent portal deployment origin (e.g. the work Preview URL).
# Defaults to PUBLIC_SITE_URL. Add its callback to Supabase Auth redirect URLs.
PARENT_PORTAL_URL=

# Optional tutor deployment origin; defaults to PARENT_PORTAL_URL/PUBLIC_SITE_URL.
TUTOR_PORTAL_URL=
