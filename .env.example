# Server-only PayFast Sandbox configuration. Never prefix these with VITE_.
PAYFAST_MERCHANT_ID=your-sandbox-merchant-id
PAYFAST_MERCHANT_KEY=your-sandbox-merchant-key
PAYFAST_ENDPOINT=https://sandbox.payfast.co.za/eng/process
PAYFAST_VALIDATE_URL=https://sandbox.payfast.co.za/eng/query/validate
PAYFAST_PASSPHRASE=
PAYFAST_NOTIFY_URL=https://www.vivatutorials.co.za/api/payfast/notify

# Email delivery via Resend
RESEND_API_KEY=re_replace-with-your-resend-key
EMAIL_FROM=Viva Tutorials <downloads@your-verified-domain.example>
ADMIN_EMAIL=vivatutorialservices@gmail.com

# Used to build PayFast return URLs in server responses.
PUBLIC_SITE_URL=https://www.vivatutorials.co.za

 