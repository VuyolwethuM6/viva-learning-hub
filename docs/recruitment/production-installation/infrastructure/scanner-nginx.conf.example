# Proposed approved DNS name. Replace certificate paths with actual issued certificates.
# No public port 3310 or 8096. Open only authenticated HTTPS gateway via reverse proxy.
server {
    listen 443 ssl;
    server_name recruitment-scanner.vivatutorials.co.za;
    ssl_certificate /etc/letsencrypt/live/recruitment-scanner.vivatutorials.co.za/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/recruitment-scanner.vivatutorials.co.za/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 11m;
    access_log off;
    location = /health {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8096;
        proxy_http_version 1.1;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 55s;
    }
    location = /scan {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8096;
        proxy_http_version 1.1;
        proxy_set_header Authorization $http_authorization;
        proxy_request_buffering off;
        proxy_read_timeout 55s;
        proxy_send_timeout 55s;
    }
    location / { return 404; }
}
# Redirect HTTP only after approved DNS/TLS provisioning. Do not log auth headers or bodies.
